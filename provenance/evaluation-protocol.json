  "inverse_task": {
    "observed_field": "solution",
    "unknown_field": "coefficient/forcing",
    "observation_count": 500,
    "observation_noise_added": 0,
    "grid": [
      128,
      128
    ],
    "observation_seed": 0,
    "mask_rule": "Official DDIS/FunDPS two 500-index draws per case; use the second draw for solution observations"
  },
  "sampling": {
    "ddis": {
      "official_class": "generation.daps_multires.PDESolverDAPS_MultiRes",
      "annealing_steps": 100,
      "diffusion_steps_per_annealing": 5,
      "langevin_steps_per_annealing": 20,
      "initial_resolution": 64,
      "upsample_at_step": 50,
      "output_resolution": 128,
      "weight_solution_phases": {
        "poisson": [
          10,
          15
        ],
        "helmholtz": [
          5,
          10
        ]
      }
    },
    "fundps": {
      "official_class": "generation.dps.PDESolverDPS",
      "diffusion_steps": 500,
      "training_resolution": 64,
      "sampling_resolution": 128
    },
    "eci": {
      "official_method": "models.functional.FFM.eci_sample",
      "euler_steps": 800,
      "eci_mix_steps": 5
    },
    "ofm": {
      "official_method": "sampling_FSGLD.samplers.LangevinDynamics",
      "langevin_steps": 100,
      "hutchinson_samples": 1,
      "ode_solver": "dopri5",
      "ode_rtol": 1e-05,
      "ode_atol": 1e-05,
      "lr_initial": 0.001,
      "lr_final": 0.0008,
      "noise_variance_parameter": 0.001,
      "temperature": 1,
      "optional_map_initialization": false
    }
  },
  "training_selection": "Minimum held-out validation loss from the early-stopping supervisor; see configs/early_stopping.json",
  "metrics": {
    "relative_l2_units": "ratio",
    "fields": [
      "coefficient",
      "solution"
    ],
    "physical_units": true,
    "clip_errors": false,
    "failed_cases": "report IDs and rate, not capped errors; all-case mean unavailable if any case fails"
  },
  "interpretation": "One declared sampling budget per method, using official algorithms. Not a reproduction of every timing budget/hyperparameter sweep in the paper."
}
